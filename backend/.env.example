PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/audit_checklist_db?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
ENCRYPTION_SECRET="your_32byte_hex_encryption_secret_here"
IMAGE_CRYPTO_SECRET="your_image_encryption_secret_here"
LEGACY_ENCRYPTION_SECRETS=""
FRONTEND_URL="http://localhost:3000"

# SparkPay Configuration
SPARKPAY_ENV="sandbox"
SPARKPAY_SERVER_KEY="your_sparkpay_server_key"
SPARKPAY_WEBHOOK_SECRET="your_sparkpay_webhook_secret"

# AI Configuration (Gemini / Ollama)
AI_PROVIDER="gemini"                  # Opsi: "gemini" atau "ollama"
GEMINI_API_KEY="your_gemini_api_key"  # Dapatkan dari: https://aistudio.google.com/
GEMINI_MODEL="gemini-1.5-flash"
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3"
